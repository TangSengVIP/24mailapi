# 24MailAPI Environment Variables

# Server Configuration
SERVER_IP=your_server_ip_here

# Domain Configuration (REQUIRED)
# DOMAIN: 邮件服务主域名 (如: mail.yourdomain.com)
DOMAIN=mail.yourdomain.com
# API_DOMAIN: API 访问域名 (如: api.mail.yourdomain.com)
API_DOMAIN=api.mail.yourdomain.com

# API Configuration (REQUIRED - CHANGE THIS IN PRODUCTION!)
# 必须在生产环境中修改为安全的随机密钥
API_KEY=123456

# Mail Configuration
MAIL_EXPIRY_HOURS=24

# Cloudflare Configuration (Optional - DNS records will be auto-configured when adding domains)
CF_API_TOKEN=your_cloudflare_api_token
CF_API_EMAIL=your_email@domain.com

# DMARC Report Email (Optional)
DMARC_REPORT_EMAIL=dmarc-reports
